# --- Application ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database ------------------------------------------------------------
# Defaults to SQLite at backend/cosmos.db, which needs no running service.
# Switch to Postgres by pointing this at a DSN — no code changes required:
# DATABASE_URL=postgresql+asyncpg://cosmos:cosmos@localhost:5432/cosmos
# DATABASE_URL=sqlite+aiosqlite:///./cosmos.db
DATABASE_ECHO=false

# --- Cache ---------------------------------------------------------------
# Leave REDIS_URL unset to use the in-process TTL cache (fine for one process).
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Auth ----------------------------------------------------------------
# MUST be replaced in any deployed environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ingestion -----------------------------------------------------------
# The NASA Exoplanet Archive TAP service is free and needs no API key.
NASA_TAP_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
INGEST_TIMEOUT_SECONDS=180
